<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Dashboard card (full width) -->
            <LinearLayout
                android:id="@+id/cardDashboard"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    style="@style/Case.Icon"
                    android:contentDescription="@string/dashboard"
                    android:src="@drawable/ic_dashboard" />

                <TextView
                    style="@style/Case.Label"
                    android:layout_marginTop="4dp"
                    android:text="@string/dashboard"
                    android:textColor="@color/black"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Row 1: Clients / Cases -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileClients"
                    style="@style/Case.Tile">
                    <ImageView
                        style="@style/Case.Icon"
                        android:contentDescription="@string/tile_clients"
                        android:src="@drawable/ic_group" />
                    <TextView
                        style="@style/Case.Label"
                        android:text="@string/tile_clients" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileCases"
                    style="@style/Case.Tile">
                    <ImageView
                        style="@style/Case.Icon"
                        android:contentDescription="@string/tile_cases"
                        android:src="@drawable/ic_work" />
                    <TextView
                        style="@style/Case.Label"
                        android:text="@string/tile_cases" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Agenda / Tasks -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileAgenda"
                    style="@style/Case.Tile">
                    <ImageView
                        style="@style/Case.Icon"
                        android:contentDescription="@string/tile_agenda"
                        android:src="@drawable/ic_calendar" />
                    <TextView
                        style="@style/Case.Label"
                        android:text="@string/tile_agenda"
                        android:textColor="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileTasks"
                    style="@style/Case.Tile">
                    <ImageView
                        style="@style/Case.Icon"
                        android:contentDescription="@string/tile_tasks"
                        android:src="@drawable/ic_file" />
                    <TextView
                        style="@style/Case.Label"
                        android:text="@string/tile_tasks" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3: Calculators / Notes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileCalculators"
                    style="@style/Case.Tile">
                    <ImageView
                        style="@style/Case.Icon"
                        android:contentDescription="@string/tile_calculators"
                        android:src="@drawable/ic_calculator" />
                    <TextView
                        style="@style/Case.Label"
                        android:text="@string/tile_calculators" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileNotes"
                    style="@style/Case.Tile">
                    <ImageView
                        style="@style/Case.Icon"
                        android:contentDescription="@string/tile_notes_plural"
                        android:src="@drawable/ic_edit_note" />
                    <TextView
                        style="@style/Case.Label"
                        android:text="@string/tile_notes_plural" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>