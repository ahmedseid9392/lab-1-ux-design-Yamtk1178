<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Profile photo drawn on top of the header -->


    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Date card -->
            <LinearLayout
                android:id="@+id/cardDate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_field"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/today_date"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/primary_blue" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/Text.LegalTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/today_date"
                    android:textColor="@color/primary_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileClients"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_purple">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_clients"
                        android:src="@drawable/ic_group"
                        app:tint="@color/black" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_clients" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileCases"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_cyan">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_cases"
                        android:src="@drawable/ic_work"
                        app:tint="@color/primary_blue" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_cases" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileAgenda"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_yellow">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_agenda"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/primary_blue" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_agenda" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileDocuments"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_cream">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_documents"
                        android:src="@drawable/ic_tile_documents" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_documents" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileLaws"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_green">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_laws"
                        android:src="@drawable/ic_tile_laws" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_laws" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileBlogs"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_pink">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_blogs"
                        android:src="@drawable/ic_tile_blogs" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_blogs" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileTasks"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_blue">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_tasks"
                        android:src="@drawable/ic_tile_tasks"
                        app:tint="@color/black" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_tasks" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileNotes"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_sand">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_notes"
                        android:src="@drawable/ic_tile_notes" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_notes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tilePetition"
                    style="@style/Tile.Card"
                    android:backgroundTint="@color/tile_blue">
                    <ImageView
                        style="@style/Tile.Icon"
                        android:contentDescription="@string/tile_petition"
                        android:src="@drawable/ic_tile_petition"
                        app:tint="@color/black" />
                    <TextView
                        style="@style/Tile.Label"
                        android:text="@string/tile_petition" />
                </LinearLayout>
            </LinearLayout>

            <!-- AI info box -->
            <LinearLayout
                android:id="@+id/boxAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_info_box"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Text.LegalTech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/ai_title"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <TextView
                    style="@style/Text.LegalTech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/ai_description"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>