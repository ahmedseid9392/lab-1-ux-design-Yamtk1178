<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Date card -->
            <LinearLayout
                android:id="@+id/cardDate"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_field"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/primary_blue"
                    android:contentDescription="@string/today_date" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/Text.LegalTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/today_date"
                    android:textColor="@color/primary_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Email field -->
            <LinearLayout
                android:id="@+id/fieldEmail"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/primary_blue"
                    android:contentDescription="@string/email" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:hint="@string/email"
                    android:importantForAutofill="yes"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress" />
            </LinearLayout>

            <!-- Password field -->
            <LinearLayout
                android:id="@+id/fieldPassword"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/primary_blue"
                    android:contentDescription="@string/password" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:hint="@string/password"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/black"
                    android:contentDescription="@string/password" />
            </LinearLayout>

            <!-- Buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/noto_sans_ethiopic"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/login"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="26dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.2"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/sign_in_google"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:backgroundTint="@color/field_gray"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="28dp"
                    app:iconTint="@null" />
            </LinearLayout>

            <!-- Register row -->
            <LinearLayout
                android:id="@+id/rowRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.LegalTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_member"
                    android:textColor="@color/black"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="26dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/black"
                    android:contentDescription="@string/register" />

                <TextView
                    android:id="@+id/tvRegister"
                    style="@style/Text.LegalTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register"
                    android:textColor="@color/primary_blue"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- AI info box -->
            <LinearLayout
                android:id="@+id/boxAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_info_box"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Text.LegalTech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/ai_title"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <TextView
                    style="@style/Text.LegalTech"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/ai_description"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>