<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom register button bar -->
    <FrameLayout
        android:id="@+id/barRegister"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="@color/bottom_nav_bg"
        android:paddingStart="37dp"
        android:paddingEnd="37dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/noto_sans_ethiopic"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/register"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="27dp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/barRegister">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="0dp"
            android:paddingEnd="26dp"
            android:paddingBottom="24dp">

            <!-- First name -->
            <LinearLayout
                android:id="@+id/fieldFirstName"
                style="@style/Field.Row"
                android:layout_marginTop="20dp">

                <ImageView
                    style="@style/Field.Icon"
                    android:contentDescription="@string/first_name"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/etFirstName"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:autofillHints="givenName"
                    android:hint="@string/first_name"
                    android:importantForAutofill="yes"
                    android:inputType="textPersonName"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Father name -->
            <LinearLayout
                android:id="@+id/fieldFatherName"
                style="@style/Field.Row">

                <ImageView
                    style="@style/Field.Icon"
                    android:contentDescription="@string/father_name"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/etFatherName"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:hint="@string/father_name"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Grandfather name -->
            <LinearLayout
                android:id="@+id/fieldGrandfatherName"
                style="@style/Field.Row">

                <ImageView
                    style="@style/Field.Icon"
                    android:contentDescription="@string/grandfather_name"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/etGrandfatherName"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:hint="@string/grandfather_name"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Email -->
            <LinearLayout
                android:id="@+id/fieldEmail"
                style="@style/Field.Row">

                <ImageView
                    style="@style/Field.Icon"
                    android:contentDescription="@string/email"
                    android:src="@drawable/ic_email" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:autofillHints="emailAddress"
                    android:hint="@string/email"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:id="@+id/fieldPhone"
                style="@style/Field.Row">

                <ImageView
                    style="@style/Field.Icon"
                    android:contentDescription="@string/phone"
                    android:src="@drawable/ic_phone" />

                <EditText
                    android:id="@+id/etPhone"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:autofillHints="phone"
                    android:hint="@string/phone"
                    android:importantForAutofill="yes"
                    android:inputType="phone"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Password -->
            <LinearLayout
                android:id="@+id/fieldPassword"
                style="@style/Field.Row">

                <ImageView
                    style="@style/Field.Icon"
                    android:contentDescription="@string/password"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:autofillHints="newPassword"
                    android:hint="@string/password"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/password"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/black" />
            </LinearLayout>

            <!-- Confirm password -->
            <LinearLayout
                android:id="@+id/fieldConfirmPassword"
                style="@style/Field.Row"
                android:layout_marginTop="20dp">

                <ImageView
                    style="@style/Field.Icon"
                    android:contentDescription="@string/confirm_password"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    style="@style/Text.Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:hint="@string/confirm_password"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ivToggleConfirmPassword"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/confirm_password"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/black" />
            </LinearLayout>

            <!-- Already a member row -->
            <LinearLayout
                android:id="@+id/rowLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.LegalTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/already_member"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="30dp"
                    android:contentDescription="@string/login_link"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/primary_blue" />

                <TextView
                    android:id="@+id/tvLogin"
                    style="@style/Text.LegalTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_link"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>